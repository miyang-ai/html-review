{
  "name": "html-review",
  "version": "0.2.0",
  "description": "Mount on any HTML page: edit text in place, comment on elements, copy a precise change request for AI.",
  "private": true,
  "license": "MIT",
  "author": "Miyang Tech (Shanghai) Co., Ltd.",
  "homepage": "https://github.com/miyang-ai/html-review",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miyang-ai/html-review.git"
  },
  "bugs": {
    "url": "https://github.com/miyang-ai/html-review/issues"
  },
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.extension.json",
    "test": "vitest run",
    "test:e2e": "node build.mjs && node --test --test-concurrency=1 tests/e2e/test_browser.mjs tests/e2e/test_extension.mjs",
    "pack:ext": "node scripts/pack-ext.mjs",
    "icons": "node scripts/render-icons.mjs",
    "store:assets": "node build.mjs && node scripts/store-assets.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "esbuild": "^0.25.12",
    "fflate": "^0.8.3",
    "jsdom": "^26.1.0",
    "lucide-static": "^1.61.0",
    "puppeteer-core": "^24.43.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
